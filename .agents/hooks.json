{
  "harness-guards": {
    "PreToolUse": [
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/restrict-to-repo-root.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-writes-to-worktree.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-bash-commands.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
