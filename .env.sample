# Comma-separated list of external paths hooks may access outside the
# harness root, in addition to repos/ and worktree/. Supports a leading `~`
# for $HOME. External access is enabled precisely when this list is
# non-empty, and only for the listed paths — there is no blanket
# "allow everything outside the harness root" switch.
# Example: ALLOWED_EXT_DIRS=~/.claude,/tmp
ALLOWED_EXT_DIRS=

# Model for /herdr-dispatch worker agents (spawned via scripts/spawn-repo-agent.sh).
# "inherit" (default) uses the same model as the Orchestrator session that
# dispatched it — the Orchestrator itself resolves this by exporting
# HERDR_ORCH_MODEL with its own model id before dispatching.
HERDR_WORKER_MODEL=inherit

# You can configure separate default models for Claude Code vs Antigravity CLI (agy):
# HERDR_WORKER_MODEL_CLAUDE=claude-sonnet-5
# HERDR_WORKER_MODEL_AGY=Gemini 3.6 Flash (High)

# CLI runner for /herdr-dispatch worker agents.
# Set to "claude", "agy" (Antigravity CLI), or "auto" (default).
# "auto" detects based on Orchestrator CLI or model type.
HERDR_AGENT_CLI=auto
