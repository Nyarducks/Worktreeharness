# Comma-separated list of external paths hooks may access outside the
# harness root, in addition to repos/ and worktree/. Supports a leading `~`
# for $HOME. External access is enabled precisely when this list is
# non-empty, and only for the listed paths — there is no blanket
# "allow everything outside the harness root" switch.
# Example: ALLOWED_EXT_DIRS=~/.claude,/tmp
ALLOWED_EXT_DIRS=

# ==============================================================================
# /herdr-dispatch Worker Settings
# ==============================================================================

# Global default worker model (falls back to "inherit" if unset)
HERDR_WORKER_MODEL=inherit

# ------------------------------------------------------------------------------
# 1. Settings when running under Claude Code (claude)
# ------------------------------------------------------------------------------
# Worker CLI runner when Orchestrator is Claude Code ("claude" or "agy")
HERDR_AGENT_CLI_CLAUDE=claude

# Worker model when launched with Claude Code (claude)
HERDR_WORKER_MODEL_CLAUDE=claude-sonnet-5

# ------------------------------------------------------------------------------
# 2. Settings when running under Antigravity CLI (agy)
# ------------------------------------------------------------------------------
# Worker CLI runner when Orchestrator is Antigravity CLI ("claude" or "agy")
HERDR_AGENT_CLI_AGY=agy

# Worker model when launched with Antigravity CLI (agy)
HERDR_WORKER_MODEL_AGY=Gemini 3.6 Flash (High)

# ------------------------------------------------------------------------------
# Override: Force specific CLI runner regardless of Orchestrator
# ------------------------------------------------------------------------------
# Set to "claude", "agy", or leave empty to use auto-resolution above
HERDR_AGENT_CLI=
