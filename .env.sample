# Comma-separated list of external paths hooks may access outside the
# harness root, in addition to repos/ and worktree/. Supports a leading `~`
# for $HOME. Prefer this scoped allowlist over ALLOW_EXTERNAL_DIR below.
# Example: ALLOWED_EXT_DIRS=~/.claude,/tmp
ALLOWED_EXT_DIRS=

# Legacy blanket bypass: set to true only when commands must access ANY path
# outside the harness root. Prefer ALLOWED_EXT_DIRS instead — this disables
# the harness-root restriction entirely. Note: even with this set to true,
# the rm safety net (blocking recursive rm on $HOME, /, etc.) still applies.
ALLOW_EXTERNAL_DIR=false
